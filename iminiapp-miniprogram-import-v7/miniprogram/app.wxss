page { background: #f7f3ea; color: #252522; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
.page { padding: 24rpx 28rpx 48rpx; box-sizing: border-box; }
.card { background: #fffdf8; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(74, 56, 36, .07); }
.section-title { font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-sub { color: #9a9186; font-size: 23rpx; margin-top: 8rpx; }
.primary-btn { background: #aa4a32; color: #fff; border-radius: 44rpx; font-size: 29rpx; font-weight: 600; }
.tag { display: inline-block; font-size: 21rpx; padding: 6rpx 14rpx; border-radius: 20rpx; color: #aa4a32; background: #f9e6dd; }
.muted { color: #989189; }

/* 首页“全部服务”面板 */
.more-pressed{opacity:.55}.all-services-mask{position:fixed;inset:0;z-index:120;background:rgba(31,25,21,.55);backdrop-filter:blur(4px)}.all-services-panel{position:fixed;left:14rpx;right:14rpx;bottom:0;z-index:121;padding:0 22rpx calc(20rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#f7f3ea;box-sizing:border-box;box-shadow:0 -18rpx 45rpx rgba(46,33,24,.22);animation:allServicesUp .22s ease-out}.all-services-handle{width:72rpx;height:7rpx;margin:13rpx auto 5rpx;border-radius:7rpx;background:#d2c8bd}.all-services-head{height:98rpx;display:flex;align-items:center;justify-content:space-between}.all-services-head>view{display:flex;flex-direction:column;gap:6rpx}.all-services-head>view text:first-child{color:#403833;font-size:29rpx;font-weight:800}.all-services-head>view text:last-child{color:#9b9188;font-size:17rpx}.all-services-head>button{width:54rpx;height:54rpx;margin:0;padding:0;border:0;border-radius:50%;background:#e9e1d7;color:#887d74;font-size:33rpx;line-height:50rpx}.all-services-head>button::after{border:0}.all-services-grid{display:grid;grid-template-columns:1fr 1fr;gap:13rpx}.all-services-grid>button{min-height:102rpx;margin:0;padding:15rpx;border:0;border-radius:20rpx;background:#fffdf8;display:flex;align-items:center;gap:13rpx;text-align:left;box-shadow:0 6rpx 17rpx rgba(68,50,36,.06)}.all-services-grid>button::after{border:0}.all-service-icon{width:58rpx;height:58rpx;flex-shrink:0;border-radius:17rpx;display:flex;align-items:center;justify-content:center;color:#654d3d;font-size:27rpx;font-weight:800}.all-service-icon.orange{background:#f4dfca}.all-service-icon.teal{background:#d7e7e3}.all-services-grid>button>view:nth-child(2){min-width:0;display:flex;flex:1;flex-direction:column;gap:5rpx}.all-services-grid>button>view:nth-child(2) text:first-child{color:#443c36;font-size:21rpx;font-weight:750}.all-services-grid>button>view:nth-child(2) text:last-child{overflow:hidden;color:#9b9189;font-size:15rpx;white-space:nowrap;text-overflow:ellipsis}.all-services-grid>button>text{color:#b4aaa1;font-size:29rpx}.all-service-pressed{transform:scale(.97);opacity:.78}.all-services-safe{height:8rpx}@keyframes allServicesUp{from{opacity:0;transform:translateY(45rpx)}to{opacity:1;transform:translateY(0)}}

/* 首页四图轮播：使用本地资源，避免网络图片加载失败 */
.home .hero-image{position:absolute;inset:0;z-index:0;width:100%;height:100%}.home .hero-shade{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(27,23,20,.76) 0%,rgba(27,23,20,.44) 47%,rgba(27,23,20,.08) 100%)}.home .hero-copy{z-index:2}.home .hero-four{background:#4f674d}

/* 首页资讯文字轮播 */
.home .notice-swiper{height:86rpx;min-width:0;flex:1}.home .notice-swiper swiper-item{height:86rpx}.home .notice-swiper .notice-text{display:block;width:100%;box-sizing:border-box}

/* 核心服务对应剪影 */
.home .core-icon{overflow:hidden}.home .core-silhouette{display:block;width:48rpx;height:48rpx;transition:transform .18s ease}.home .core-active .core-silhouette{transform:scale(1.12)}

/* 场馆详情地图 */
.venue-map-card{margin-top:24rpx;padding:22rpx;overflow:hidden}.venue-map-card>view:first-child{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.venue-map-card>view:first-child>view{min-width:0;display:flex;flex-direction:column;gap:7rpx}.venue-map-card>view:first-child>view text:first-child{color:#403a35;font-size:25rpx;font-weight:750}.venue-map-card>view:first-child>view text:last-child{color:#928980;font-size:18rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.venue-map-card button{width:132rpx;height:58rpx;margin:0;padding:0;border:0;border-radius:29rpx;background:#4f7369;color:#fff;font-size:19rpx;line-height:58rpx}.venue-map-card button::after{border:0}.venue-map{width:100%;height:310rpx;margin-top:20rpx;border-radius:17rpx;overflow:hidden}.venue-map-pending{height:180rpx;margin-top:20rpx;border-radius:17rpx;background:linear-gradient(135deg,#eef1ed,#e4e9e3);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;color:#607067}.venue-map-pending text:first-child{font-size:25rpx;font-weight:750}.venue-map-pending text:last-child{font-size:17rpx}

/* 微信原生分享面板（历史类名仅用于保持现有样式兼容） */
.share-channel-mask{position:fixed;inset:0;z-index:500;background:rgba(24,20,17,.58);display:flex;align-items:flex-end}.share-channel-panel{width:100%;padding:18rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#f7f3ea;box-sizing:border-box;box-shadow:0 -18rpx 44rpx rgba(38,28,21,.2);animation:shareChannelUp .2s ease-out}.share-channel-head{height:94rpx;display:flex;align-items:center;justify-content:space-between}.share-channel-head>view{display:flex;flex-direction:column;gap:6rpx}.share-channel-head>view text:first-child{color:#413a35;font-size:29rpx;font-weight:800}.share-channel-head>view text:last-child{color:#9a9188;font-size:18rpx}.share-channel-head>button{width:54rpx;height:54rpx;margin:0;padding:0;border:0;border-radius:50%;background:#e9e1d8;color:#80756c;font-size:35rpx;line-height:50rpx}.share-channel-head>button::after,.share-channel-options>button::after{border:0}.share-channel-options{display:flex;flex-direction:column;gap:14rpx}.share-channel-options>button{height:104rpx;margin:0;padding:14rpx 18rpx;border:0;border-radius:21rpx;background:#fffdf8;display:flex;align-items:center;gap:16rpx;text-align:left;box-shadow:0 6rpx 18rpx rgba(66,48,34,.06)}.share-channel-icon{width:62rpx;height:62rpx;flex-shrink:0;border-radius:19rpx;color:#fff;font-size:24rpx;font-weight:800;display:flex;align-items:center;justify-content:center}.wechat-channel{background:#20ad66}.qq-channel{background:#188de0}.share-channel-options>button>view:nth-child(2){min-width:0;flex:1;display:flex;flex-direction:column;gap:6rpx}.share-channel-options>button>view:nth-child(2) text:first-child{color:#443d37;font-size:23rpx;font-weight:700}.share-channel-options>button>view:nth-child(2) text:last-child{color:#9a9189;font-size:17rpx}.share-channel-options>button>text{color:#b5aca3;font-size:32rpx}.share-channel-note{display:block;margin-top:18rpx;text-align:center;color:#a0968d;font-size:17rpx}@keyframes shareChannelUp{from{transform:translateY(50rpx);opacity:0}to{transform:translateY(0);opacity:1}}
