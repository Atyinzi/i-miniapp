.page{min-height:100vh;padding:30rpx;background:#f7f3ea;box-sizing:border-box}.document-head{padding:32rpx 28rpx;border-radius:26rpx;background:linear-gradient(125deg,#354f45,#68775d);color:#fff;display:flex;flex-direction:column;gap:12rpx}.document-head text:first-child{font-size:34rpx;font-weight:800}.document-head text:last-child{color:rgba(255,255,255,.7);font-size:19rpx}.notice{margin:20rpx 0;padding:18rpx;border-radius:18rpx;background:#f4e6d7;color:#8d5b3e;font-size:20rpx;line-height:1.6}.section{margin-bottom:16rpx;padding:24rpx;border-radius:22rpx;background:#fffdf8;box-shadow:0 7rpx 20rpx rgba(68,50,36,.05);display:flex;flex-direction:column;gap:13rpx}.section text:first-child{color:#433b35;font-size:24rpx;font-weight:800}.section text:last-child{color:#756b63;font-size:21rpx;line-height:1.75}
