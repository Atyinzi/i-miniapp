.driver-page{padding-bottom:50rpx}.driver-hero{height:230rpx;padding:38rpx;border-radius:28rpx;background:linear-gradient(135deg,#293b3a,#5c8278);box-sizing:border-box;color:#fff;display:flex;flex-direction:column;gap:12rpx}.driver-hero text:first-child{font-size:17rpx;letter-spacing:4rpx;opacity:.7}.driver-hero text:nth-child(2){font-size:40rpx;font-weight:800}.driver-hero text:last-child{font-size:21rpx;opacity:.8}.driver-empty,.driver-profile,.task-card{margin-top:24rpx;padding:25rpx}.driver-empty{min-height:150rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;color:#91887f;font-size:22rpx}.driver-profile>view,.task-head,.task-meta{display:flex;align-items:center;justify-content:space-between}.driver-profile>view text:first-child{font-size:27rpx;font-weight:750}.driver-profile>view text:last-child,.task-head>text{padding:7rpx 12rpx;border-radius:18rpx;background:#e9f0eb;color:#52705f;font-size:17rpx}.driver-profile>text{display:block;margin-top:14rpx;color:#948b82;font-size:17rpx;line-height:1.55}.task-kind{display:inline-block;margin-bottom:13rpx;padding:6rpx 13rpx;border-radius:18rpx;background:#f1e1d6;color:#9c533b;font-size:17rpx}.task-head>view{display:flex;flex-direction:column;gap:6rpx}.task-head>view text:first-child{font-size:29rpx;font-weight:800}.task-head>view text:last-child{color:#968c83;font-size:17rpx}.route{margin:22rpx 0;padding:18rpx;border-radius:18rpx;background:#f3eee7;display:flex;flex-direction:column;gap:15rpx}.route>view{display:flex;align-items:center;gap:12rpx}.route>view>text:first-child{width:42rpx;height:42rpx;border-radius:50%;background:#5f7e6d;color:#fff;text-align:center;line-height:42rpx;font-size:17rpx}.route>view:last-child>text:first-child{background:#aa4a32}.route>view>text:last-child{font-size:21rpx;color:#4d4640}.task-meta{margin-bottom:18rpx;color:#928980;font-size:17rpx}.task-card>.primary-btn{height:72rpx;line-height:72rpx}.location-actions{padding:17rpx;border-radius:17rpx;background:#eef3ee;display:flex;align-items:center;justify-content:space-between}.location-actions button{height:56rpx;margin:0;padding:0 20rpx;border:0;border-radius:28rpx;background:#4f7369;color:#fff;font-size:18rpx;line-height:56rpx}.location-actions button::after{border:0}.location-actions text{color:#7f8c83;font-size:16rpx}.driver-map{width:100%;height:310rpx;margin-top:16rpx;border-radius:16rpx;overflow:hidden}.complete-form{margin-top:18rpx;display:flex;flex-direction:column;gap:12rpx}.complete-form input{height:70rpx;padding:0 18rpx;border:1rpx solid #ded6cd;border-radius:14rpx;background:#fff}.complete-form button{height:68rpx;border:0;border-radius:34rpx;background:#aa4a32;color:#fff;font-size:21rpx;line-height:68rpx}.complete-form button::after{border:0}.task-history{margin-top:35rpx}.task-history>text{font-size:27rpx;font-weight:750}.history-row{margin-top:14rpx;padding:19rpx;display:flex;align-items:center;justify-content:space-between}.history-row>view{min-width:0;display:flex;flex-direction:column;gap:7rpx}.history-row>view text:first-child{font-size:20rpx;font-weight:700}.history-row>view text:last-child{max-width:500rpx;color:#978e85;font-size:16rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.history-row>text{color:#a4543d;font-size:17rpx}
