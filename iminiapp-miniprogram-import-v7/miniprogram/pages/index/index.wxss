.home{padding-top:24rpx;overflow:hidden}.platform-nav{position:fixed;top:0;left:0;right:0;z-index:99;height:104rpx;padding:18rpx 28rpx;background:rgba(247,243,234,.98);box-sizing:border-box;display:flex;align-items:center;gap:10rpx;box-shadow:0 6rpx 16rpx rgba(82,63,42,.07)}.nav-spacer{height:100rpx}.platform-logo{display:flex;align-items:center;gap:7rpx;flex-shrink:0}.logo-mark{width:47rpx;height:47rpx;border-radius:13rpx;background:#a94a32;color:#fff;display:flex;align-items:center;justify-content:center;position:relative;font-size:19rpx;font-weight:800;overflow:hidden}.logo-mark text:first-child{transform:translateX(-7rpx)}.logo-mark text:last-child{position:absolute;right:4rpx;bottom:4rpx;font-size:14rpx;color:#f3c06b}.logo-copy{display:flex;flex-direction:column;line-height:1.15;color:#493c34;font-size:20rpx;font-weight:800}.logo-copy text:last-child{font-size:13rpx;color:#8c796e;font-weight:500}.search-box{height:56rpx;flex:1;min-width:0;border:1rpx solid #e4ddd1;background:#fffdf8;border-radius:30rpx;display:flex;align-items:center;padding:0 12rpx;box-sizing:border-box}.search-icon{font-size:31rpx;color:#a99d92;margin-right:5rpx}.search-box input{flex:1;min-width:0;font-size:19rpx;color:#5b524b}.mine-entry{font-size:20rpx;color:#574940;display:flex;flex-direction:column;align-items:center;line-height:1.1;white-space:nowrap}.mine-entry text:last-child{font-size:16rpx;color:#9b8d82}.message{width:34rpx;height:50rpx;position:relative;display:flex;align-items:center;justify-content:center;color:#594b42;font-size:29rpx}.message view{width:11rpx;height:11rpx;background:#cf573e;border-radius:50%;position:absolute;right:0;top:7rpx;border:2rpx solid #f7f3ea}.topbar,.welcome,.quick-title,.core-head { display:flex; align-items:center; justify-content:space-between; }.brand { font-size:44rpx; font-weight:800; letter-spacing:6rpx; }.brand-en { font-size:16rpx; letter-spacing:2rpx; color:#aa4a32; margin-top:6rpx; }.avatar { width:64rpx;height:64rpx;border-radius:50%;background:#2d3d3c;color:#fff;display:flex;align-items:center;justify-content:center;font-size:25rpx; }.welcome { margin:26rpx 2rpx 20rpx;color:#716b63;font-size:24rpx; }.weather { color:#b16b30; }.hero { height:430rpx;border-radius:28rpx;overflow:hidden;box-shadow:0 18rpx 34rpx rgba(57,39,22,.16); }.hero-bg { height:100%;padding:44rpx 38rpx;box-sizing:border-box;position:relative;overflow:hidden; }.hero-bg:after { content:"";position:absolute;width:380rpx;height:380rpx;border:2rpx solid rgba(255,255,255,.25);border-radius:50%;right:-140rpx;bottom:-180rpx; }.hero-one { background:linear-gradient(120deg,#293b3a,#566d65 55%,#ad7241); }.hero-two { background:linear-gradient(120deg,#3b3028,#76604c 58%,#b34f34); }.hero-three { background:linear-gradient(120deg,#5a2930,#a94d38 55%,#e5a353); }.hero-copy { position:relative;z-index:1;color:#fff;display:flex;flex-direction:column; }.eyebrow { font-size:18rpx;letter-spacing:3rpx;opacity:.75; }.hero-title { font-size:50rpx;line-height:1.35;font-weight:700;margin-top:22rpx;letter-spacing:3rpx; }.hero-link { margin-top:32rpx;font-size:24rpx;background:rgba(255,255,255,.16);width:max-content;padding:12rpx 18rpx;border-radius:24rpx; }.hero-dots{height:32rpx;display:flex;align-items:center;justify-content:center;gap:12rpx}.hero-dot{width:12rpx;height:12rpx;border-radius:50%;background:#c4b7aa;transition:all .2s}.hero-dot-active{width:30rpx;border-radius:8rpx;background:#aa4a32}.quick-title,.core-head { margin:28rpx 4rpx 22rpx; }.quick-title view,.core-head view { display:flex;flex-direction:column; }.more { color:#aa4a32;font-size:23rpx; }.quick-grid { display:grid;grid-template-columns:repeat(5,1fr);gap:14rpx;margin-bottom:32rpx; }.quick-item { display:flex;flex-direction:column;align-items:center;font-size:22rpx;font-weight:600;white-space:nowrap;transition:transform .14s ease; }.quick-active{animation:quickPulse .28s ease-out}.quick-active .quick-icon{animation:quickFlash .28s ease-out}.quick-icon { width:82rpx;height:82rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;font-size:39rpx;margin-bottom:12rpx; }.sand { background:#f3e1c4; }.red { background:#f4dcd3; }.green { background:#dceae0; }.blue { background:#dce8ed; }.gold { background:#f7ebca; }.quick-desc { font-weight:400;font-size:17rpx;color:#aaa198;margin-top:3rpx; }.notice { height:86rpx;margin-top:40rpx;padding:0 20rpx;display:flex;align-items:center;gap:14rpx; }.notice-symbol { color:#aa4a32;font-size:32rpx; }.notice-label { color:#aa4a32;font-weight:700;font-size:24rpx;white-space:nowrap; }.notice-text { flex:1;line-height:86rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:23rpx;color:#5d5954; }.notice-arrow { font-size:42rpx;color:#b5ada3; }.core-head{margin-top:40rpx}.core-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.core-item{height:112rpx;background:#fffdf8;border-radius:20rpx;padding:16rpx;box-sizing:border-box;display:flex;align-items:center;gap:14rpx;box-shadow:0 8rpx 24rpx rgba(74,56,36,.06);transition:transform .14s ease}.core-active{animation:quickPulse .28s ease-out}.core-active .core-icon{animation:quickFlash .28s ease-out}.core-icon{width:62rpx;height:62rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-size:31rpx;flex-shrink:0}.core-copy{min-width:0;display:flex;flex-direction:column;gap:7rpx}.core-copy text:first-child{font-size:25rpx;font-weight:700;white-space:nowrap}.core-copy text:last-child{font-size:18rpx;color:#9d958c;white-space:nowrap}.core-arrow{margin-left:auto;color:#b8afa5;font-size:30rpx}.platform-footer{display:grid;grid-template-columns:1fr 1.25fr 1fr;align-items:center;gap:12rpx;margin:42rpx -28rpx -48rpx;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));min-height:112rpx;box-sizing:border-box;border-top:1rpx solid #e5ddd1;background:#efe9de;color:#766d64}.footer-contact{display:flex;flex-direction:column;gap:7rpx;font-size:20rpx;line-height:1.25;white-space:nowrap}.footer-contact text:first-child{font-size:18rpx;color:#9a9187}.footer-contact text:last-child{font-weight:600;color:#5c534b;letter-spacing:.4rpx}.footer-copyright{align-self:center;transform:translateY(16rpx);text-align:center;font-size:18rpx;line-height:1.5;color:#8b8279}.feedback-entry{width:100%;min-height:80rpx;margin:0;padding:0 16rpx;border:0;border-radius:0;background:transparent;color:#5c534b;font-size:21rpx;line-height:80rpx;text-align:center}.feedback-entry::after{border:0}@keyframes quickPulse{0%{transform:scale(1)}45%{transform:scale(.86)}100%{transform:scale(1)}}@keyframes quickFlash{0%{filter:brightness(1)}50%{filter:brightness(1.28);box-shadow:0 0 0 12rpx rgba(255,255,255,.5)}100%{filter:brightness(1);box-shadow:none}}
