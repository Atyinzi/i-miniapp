<view class="page home">
  <view class="platform-nav">
    <view class="platform-logo" bindtap="goHome">
      <view class="logo-mark"><text>北</text><text>重</text></view>
      <view class="logo-copy"><text>i某小程序</text><text>产业服务平台</text></view>
    </view>
    <view class="search-box"><text class="search-icon">⌕</text><input placeholder="搜索景点、资讯、商品" value="{{keyword}}" bindinput="keywordInput" confirm-type="search" bindconfirm="search"/></view>
    <view class="mine-entry" bindtap="goMine"><text>我的</text><text>⌄</text></view>
    <view class="message" bindtap="messageTap"><text>♧</text><view wx:if="{{unread}}"></view></view>
  </view>
  <view class="nav-spacer"></view>
  <view class="quick-title"><view><text class="section-title">快捷服务</text><text class="section-sub">为你的i某小程序之旅做好准备</text></view><text class="more" bindtap="showAllServices" hover-class="more-pressed" role="button">全部服务  ›</text></view>
  <view class="quick-grid">
    <view class="quick-item {{activeQuick === index ? 'quick-active' : ''}}" wx:for="{{quickItems}}" wx:key="name" bindtap="quickTap" bindtouchstart="quickPress" bindtouchend="quickRelease" bindtouchcancel="quickRelease" data-index="{{index}}" data-url="{{item.url}}"><view class="quick-icon {{item.color}}">{{item.icon}}</view><text>{{item.name}}</text><text class="quick-desc">{{item.desc}}</text></view>
  </view>
  <swiper class="hero" current="{{currentSlide}}" autoplay circular interval="4000" bindchange="slideChange">
    <swiper-item><view class="hero-bg hero-one" bindtap="goVenue"><image class="hero-image" src="/assets/images/rooms/elegant-king-main.jpg" mode="aspectFill"/><view class="hero-shade"></view><view class="hero-copy"><text class="eyebrow">INDUSTRIAL MEMORY</text><text class="hero-title">把时光，住进<br/>i某小程序的故事里</text><text class="hero-link">探索示例宾馆  →</text></view></view></swiper-item>
    <swiper-item><view class="hero-bg hero-two" bindtap="goWeaponCity"><image class="hero-image" src="/assets/images/weapon-city/tank-ride.jpg" mode="aspectFill"/><view class="hero-shade"></view><view class="hero-copy"><text class="eyebrow">WEEKEND PLAN</text><text class="hero-title">一城兵器史<br/>一段热血旅程</text><text class="hero-link">立即出发  →</text></view></view></swiper-item>
    <swiper-item><view class="hero-bg hero-three" bindtap="goMall"><image class="hero-image" src="/assets/images/mall/tank-model.jpg" mode="aspectFill"/><view class="hero-shade"></view><view class="hero-copy"><text class="eyebrow">LOCAL GOODNESS</text><text class="hero-title">i某小程序好物<br/>带回家</text><text class="hero-link">逛逛商城  →</text></view></view></swiper-item>
    <swiper-item><view class="hero-bg hero-four" bindtap="goHoushan"><image class="hero-image" src="/assets/images/houshan/mountain-twin-room.jpg" mode="aspectFill"/><view class="hero-shade"></view><view class="hero-copy"><text class="eyebrow">MOUNTAIN RETREAT</text><text class="hero-title">山居入梦<br/>与自然相逢</text><text class="hero-link">探索后山住宿  →</text></view></view></swiper-item>
  </swiper>
  <view class="hero-dots"><view wx:for="{{bannerCount}}" wx:key="*this" class="hero-dot {{currentSlide === index ? 'hero-dot-active' : ''}}" bindtap="chooseSlide" data-index="{{index}}"></view></view>
  <view class="notice card"><view class="notice-symbol" bindtap="openInformation">◎</view><view class="notice-label" bindtap="openInformation">i某小程序资讯</view><swiper class="notice-swiper" current="{{noticeIndex}}" vertical="{{true}}" autoplay="{{notices.length > 1}}" circular="{{true}}" interval="3000" duration="320" bindchange="noticeChange"><swiper-item wx:for="{{notices}}" wx:key="*this"><text class="notice-text" bindtap="openNotice">{{item}}</text></swiper-item></swiper><text class="notice-arrow" bindtap="nextNotice">›</text></view>
  <view class="core-head"><view><text class="section-title">核心服务</text><text class="section-sub">开启你的i某小程序之旅</text></view></view>
  <view class="core-grid">
    <view class="core-item {{activeCore === index ? 'core-active' : ''}}" wx:for="{{coreItems}}" wx:key="name" bindtap="coreTap" bindtouchstart="corePress" bindtouchend="coreRelease" bindtouchcancel="coreRelease" data-index="{{index}}" data-url="{{item.url}}"><view class="core-icon {{item.color}}"><image class="core-silhouette" src="{{item.image}}" mode="aspectFit"/></view><view class="core-copy"><text>{{item.name}}</text><text>{{item.desc}}</text></view><text class="core-arrow">›</text></view>
  </view>
  <view class="platform-footer">
    <text class="footer-copyright">i某小程序产业服务平台©版权所有</text>
    <button class="feedback-entry" open-type="feedback" aria-label="意见反馈">意见反馈</button>
  </view>
  <view wx:if="{{allServicesVisible}}" class="all-services-mask" bindtap="closeAllServices" catchtouchmove="preventServicePanelTap"></view>
  <view wx:if="{{allServicesVisible}}" class="all-services-panel" catchtap="preventServicePanelTap">
    <view class="all-services-handle"></view>
    <view class="all-services-head"><view><text>全部服务</text><text>选择需要办理的文旅服务</text></view><button bindtap="closeAllServices">×</button></view>
    <view class="all-services-grid">
      <button wx:for="{{allServices}}" wx:key="name" bindtap="allServiceTap" data-url="{{item.url}}" hover-class="all-service-pressed"><view class="all-service-icon {{item.color}}">{{item.icon}}</view><view><text>{{item.name}}</text><text>{{item.desc}}</text></view><text>›</text></button>
    </view>
    <view class="all-services-safe"></view>
  </view>
</view>
