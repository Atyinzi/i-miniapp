.information-page{min-height:100vh;background:#f6f2ea;color:#403934}
.status-bar{position:sticky;top:0;z-index:31;background:rgba(247,243,234,.98)}
.information-nav{height:94rpx;padding:0 24rpx;position:sticky;top:0;z-index:30;box-sizing:border-box;background:rgba(247,243,234,.98);box-shadow:0 5rpx 18rpx rgba(72,55,39,.06);display:flex;align-items:center;gap:14rpx}
.nav-back{width:58rpx;height:58rpx;flex-shrink:0;margin:0;padding:0;border:0;border-radius:50%;background:#fffdf8;color:#544b44;font-size:48rpx;line-height:51rpx;box-shadow:0 5rpx 13rpx rgba(76,55,36,.08)}
.nav-back::after,.nav-search button::after,.category-tab::after,.detail-actions button::after,.preview-head button::after{border:0}
.nav-title{flex-shrink:0;color:#423a35;font-size:29rpx;font-weight:800;letter-spacing:2rpx}
.nav-search{height:58rpx;min-width:0;flex:1;padding:0 10rpx 0 14rpx;border:1rpx solid #e2d9ce;border-radius:30rpx;background:#fffdf8;box-sizing:border-box;display:flex;align-items:center}
.search-symbol{margin-right:7rpx;color:#9f9489;font-size:29rpx}
.nav-search input{height:56rpx;min-width:0;flex:1;color:#544c45;font-size:19rpx}
.search-clear{width:40rpx;height:40rpx;margin:0;padding:0;border:0;border-radius:50%;background:#eee7de;color:#8e8278;font-size:27rpx;line-height:37rpx}
.detail-nav{justify-content:space-between}
.detail-nav-title{font-size:29rpx;font-weight:800;letter-spacing:2rpx}
.nav-placeholder{width:58rpx}
.list-view{padding-bottom:54rpx}
.category-tabs{width:100%;padding:24rpx 28rpx 20rpx;box-sizing:border-box;background:#f6f2ea;white-space:nowrap}
.category-tab{display:inline-block;width:auto;height:60rpx;margin:0 12rpx 0 0;padding:0 24rpx;border:1rpx solid #dfd5ca;border-radius:30rpx;background:#fffdf8;color:#776e66;font-size:21rpx;line-height:58rpx}
.category-tab-active{border-color:#aa4a32;background:#aa4a32;color:#fff;font-weight:700;box-shadow:0 7rpx 16rpx rgba(170,74,50,.16)}
.information-intro{margin:0 28rpx 22rpx;padding:23rpx 24rpx;border-radius:22rpx;background:linear-gradient(125deg,#49372f,#7f5543 64%,#b37a55);color:#fff;display:flex;align-items:center;justify-content:space-between;box-shadow:0 12rpx 25rpx rgba(67,45,30,.12)}
.information-intro>view{display:flex;flex-direction:column;gap:7rpx}
.information-intro>view text:first-child{font-size:28rpx;font-weight:800;letter-spacing:2rpx}
.information-intro>view text:last-child{font-size:18rpx;opacity:.72}
.information-intro>text{padding:7rpx 12rpx;border-radius:16rpx;background:rgba(255,255,255,.16);font-size:17rpx}
.article-list{padding:0 28rpx}
.article-card{min-height:224rpx;margin-bottom:18rpx;padding:17rpx;border:1rpx solid rgba(167,130,93,.1);border-radius:24rpx;background:#fffdf8;box-sizing:border-box;display:flex;gap:18rpx;box-shadow:0 8rpx 22rpx rgba(74,56,36,.07);transition:transform .14s ease}
.article-card-pressed{transform:scale(.986);opacity:.92}
.article-cover{width:190rpx;height:190rpx;flex-shrink:0;border-radius:18rpx;background:#ded5cb}
.article-copy{min-width:0;flex:1;display:flex;flex-direction:column}
.article-meta{height:32rpx;display:flex;align-items:center;justify-content:space-between;color:#a1988f;font-size:16rpx}
.article-category{padding:4rpx 9rpx;border-radius:12rpx;background:#f4e5db;color:#a44c36;font-size:15rpx}
.article-title{display:-webkit-box;overflow:hidden;margin-top:10rpx;color:#403934;font-size:25rpx;font-weight:800;line-height:1.35;text-align:center;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.article-summary{display:-webkit-box;overflow:hidden;margin-top:9rpx;color:#8a8179;font-size:18rpx;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.article-source{margin-top:auto;display:flex;align-items:center;justify-content:space-between;color:#a1988f;font-size:16rpx}
.article-source text:last-child{color:#a94a32}
.empty-information{padding:110rpx 30rpx;display:flex;flex-direction:column;align-items:center;color:#988f86}
.empty-symbol{width:84rpx;height:84rpx;margin-bottom:22rpx;border-radius:28rpx;background:#eadfd3;color:#9a674d;text-align:center;font-size:34rpx;line-height:84rpx}
.empty-information text:nth-child(2){color:#5c544d;font-size:26rpx;font-weight:700}
.empty-information text:last-child{margin-top:10rpx;font-size:19rpx}
.detail-view{padding:42rpx 36rpx calc(60rpx + env(safe-area-inset-bottom))}
.detail-category-row{display:flex;align-items:center;justify-content:space-between;color:#a1988f;font-size:18rpx}
.detail-category-row text:first-child{padding:6rpx 12rpx;border-radius:15rpx;background:#f3e3d8;color:#a34c36}
.information-title{display:block;margin-top:25rpx;color:#382f2a;font-size:42rpx;font-weight:800;line-height:1.45;letter-spacing:1rpx}
.information-byline{margin-top:19rpx;display:flex;gap:22rpx;color:#9a9188;font-size:19rpx}
.title-divider{height:2rpx;margin:29rpx 0;background:#e7ded3}
.title-divider view{width:76rpx;height:4rpx;transform:translateY(-1rpx);background:#aa4a32}
.information-lead{display:block;margin-bottom:28rpx;padding:22rpx 24rpx;border-left:6rpx solid #aa4a32;border-radius:0 16rpx 16rpx 0;background:#eee7de;color:#625a53;font-size:23rpx;font-weight:600;line-height:1.75}
.information-paragraph{display:block;margin-bottom:27rpx;color:#514943;font-size:26rpx;line-height:2;text-align:justify}
.information-image{display:block;width:100%;height:390rpx;margin:5rpx 0 31rpx;border-radius:22rpx;background:#d8d0c7;box-shadow:0 10rpx 23rpx rgba(65,46,31,.1)}
.information-end{margin:48rpx 0 31rpx;display:flex;align-items:center;gap:16rpx;color:#a69c93;font-size:18rpx}
.information-end view{height:1rpx;flex:1;background:#ddd4ca}
.detail-actions{display:flex;gap:16rpx}
.detail-actions button{height:78rpx;flex:1;margin:0;padding:0;border:1rpx solid #d9cec3;border-radius:39rpx;background:#fffdf8;color:#665c54;display:flex;align-items:center;justify-content:center;gap:10rpx;font-size:22rpx;line-height:78rpx}
.detail-actions button text:first-child{font-size:30rpx}
.detail-actions .favorite-active{border-color:#c49365;background:#f6e9d8;color:#9b6339}
.detail-actions .share-button{border-color:#aa4a32;background:#aa4a32;color:#fff}
.image-preview{position:fixed;left:0;right:0;top:0;bottom:0;z-index:100;padding:32rpx;box-sizing:border-box;background:rgba(17,14,12,.94);display:flex;align-items:center;justify-content:center}
.preview-panel{width:100%;max-width:720rpx}
.preview-head{margin-bottom:22rpx;color:#fff;display:flex;align-items:center;justify-content:space-between}
.preview-head>text{font-size:27rpx;font-weight:600}
.preview-head button{width:68rpx;height:68rpx;margin:0;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.14);color:#fff;font-size:46rpx;line-height:64rpx}
.preview-image{display:block;width:100%;height:760rpx;border-radius:18rpx;background:#111}
.preview-hint{display:block;margin-top:22rpx;text-align:center;color:rgba(255,255,255,.66);font-size:20rpx}
