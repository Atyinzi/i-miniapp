<view class="page"><view class="play-hero"><text class="play-en">EXPLORE IMINIAPP</text><text>今天，去哪里？</text><text class="play-desc">收藏一段工业岁月，也收藏此刻的欢喜</text></view><view class="tabs"><text wx:for="{{tabs}}" wx:key="*this" class="{{active===index?'active':''}}" bindtap="switchTab" data-index="{{index}}">{{item}}</text></view><view class="place card" wx:for="{{places}}" wx:key="name" bindtap="openPlace" data-index="{{index}}"><view class="place-art {{item.color}}"><text>{{item.symbol}}</text><view>{{item.label}}</view></view><view class="place-info"><view class="place-name">{{item.name}}</view><view class="place-text">{{item.desc}}</view><view class="place-footer"><text>{{item.distance}}</text><text class="tag">{{item.tag}}</text></view></view><text class="place-arrow">›</text></view></view>
