.play-hero{height:265rpx;border-radius:28rpx;background:linear-gradient(130deg,#863c2f,#c46b44,#edb25a);color:#fff;padding:38rpx;box-sizing:border-box;display:flex;flex-direction:column;gap:17rpx;font-size:45rpx;font-weight:700}.play-en{font-size:18rpx;letter-spacing:4rpx;opacity:.75}.play-desc{font-size:23rpx;font-weight:400;opacity:.9}.tabs{display:flex;gap:42rpx;margin:34rpx 7rpx 22rpx;color:#918a82;font-size:27rpx}.tabs text{padding-bottom:12rpx}.tabs .active{color:#aa4a32;font-weight:700;border-bottom:5rpx solid #aa4a32}.place{padding:16rpx;display:flex;align-items:center;gap:18rpx;margin-bottom:20rpx}.place-art{width:175rpx;height:160rpx;border-radius:19rpx;color:rgba(255,255,255,.88);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:54rpx}.place-art view{font-size:18rpx;margin-top:6rpx;letter-spacing:2rpx}.olive{background:linear-gradient(135deg,#48584a,#8a9b71)}.orange{background:linear-gradient(135deg,#8e442e,#d48648)}.teal{background:linear-gradient(135deg,#31545a,#7faaa1)}.rust{background:linear-gradient(135deg,#694036,#ae7258)}.blue{background:linear-gradient(135deg,#35566d,#7599ad)}.green{background:linear-gradient(135deg,#3e614e,#83a678)}.place-info{flex:1;display:flex;flex-direction:column;gap:13rpx}.place-name{font-size:30rpx;font-weight:700}.place-text{font-size:21rpx;color:#8e867e;line-height:1.5}.place-footer{display:flex;justify-content:space-between;align-items:center;color:#9b938a;font-size:20rpx}.place-arrow{font-size:43rpx;color:#b4aaa0}
