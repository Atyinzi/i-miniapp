.venue-hero-houshan{background:linear-gradient(145deg,#273b34,#536b55 58%,#9a926b)}
.venue-hero-houshan:before{content:"";position:absolute;left:0;right:0;top:0;bottom:0;z-index:1;background:linear-gradient(90deg,rgba(20,30,25,.72),rgba(20,30,25,.28) 62%,rgba(20,30,25,.08))}
.venue-hero-houshan:after{z-index:1}
.houshan-hero-image{position:absolute;left:0;top:0;width:100%;height:100%;z-index:0}
.venue-hero-houshan .hero-label,.venue-hero-houshan .venue-title,.venue-hero-houshan .venue-desc{position:relative;z-index:2}
.houshan-photo-note{position:absolute;right:24rpx;bottom:18rpx;z-index:3;padding:7rpx 12rpx;border-radius:15rpx;background:rgba(19,29,24,.55);font-size:16rpx}
