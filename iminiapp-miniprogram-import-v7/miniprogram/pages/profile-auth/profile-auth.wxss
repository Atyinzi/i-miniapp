.page{min-height:100vh;padding:32rpx;background:#f7f3ea;box-sizing:border-box}.card{padding:36rpx 30rpx;border-radius:30rpx;background:#fffdf8;box-shadow:0 12rpx 30rpx rgba(68,50,36,.08);display:flex;flex-direction:column;gap:24rpx}.title{color:#3f3833;font-size:36rpx;font-weight:800}.description,.privacy{color:#8d837a;font-size:22rpx;line-height:1.6}.section-label{margin-top:12rpx;padding-top:24rpx;border-top:1rpx solid #eee4da;color:#544b44;font-size:25rpx;font-weight:700}.avatar-button{width:220rpx;margin:10rpx auto;padding:0;background:transparent;color:#6f655d;font-size:22rpx;line-height:1.4}.avatar-button image,.avatar-button>text{width:128rpx;height:128rpx;margin:0 auto 14rpx;border-radius:38rpx;background:#a9533b;color:#fff;display:block;font-size:44rpx;line-height:128rpx}.field{min-height:94rpx;padding:0 20rpx;border:1rpx solid #e4d8cd;border-radius:20rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx}.field>text:first-child{color:#544b44;font-size:24rpx;font-weight:700}.field input{height:94rpx;flex:1;text-align:right}.phone-field>text:last-child{color:#857a72}.phone-button,.save-button,.login-button{height:82rpx;border-radius:41rpx;font-size:25rpx;line-height:82rpx}.phone-button{border:1rpx solid #a9533b;background:#fff;color:#a9533b}.save-button,.login-button{background:#a9533b;color:#fff}.privacy{text-align:center}
