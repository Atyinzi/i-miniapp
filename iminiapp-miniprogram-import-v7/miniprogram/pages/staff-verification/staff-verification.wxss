page{background:#f3efe6;color:#322e2a}.verification-page{min-height:100vh;padding:22rpx 25rpx;box-sizing:border-box}.card{border:1rpx solid rgba(91,72,55,.08);border-radius:26rpx;background:#fffdf8;box-shadow:0 9rpx 25rpx rgba(60,46,35,.065)}button::after{border:0}
.hero{padding:30rpx 27rpx;border-radius:29rpx;background:linear-gradient(135deg,#20332e,#3f5c51 62%,#7a6545);color:#fff}.hero-head{display:flex;align-items:center;gap:13rpx}.hero-head>text:first-child{font-size:39rpx;font-weight:850;letter-spacing:2rpx}.environment-tag{padding:6rpx 11rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:17rpx;color:#e9d8ae;font-size:17rpx}.hero>text{display:block;margin-top:10rpx;color:rgba(255,255,255,.66);font-size:19rpx}.connection{min-height:58rpx;margin-top:26rpx;padding:0 17rpx;border-radius:18rpx;background:rgba(6,14,11,.24);display:flex;align-items:center;gap:11rpx;font-size:18rpx}.connection-dot{width:13rpx;height:13rpx;border-radius:50%;background:#e3bd6f}.connection-READY .connection-dot{background:#75d5a5;box-shadow:0 0 0 6rpx rgba(117,213,165,.12)}.connection-ERROR .connection-dot,.connection-UNAVAILABLE .connection-dot{background:#e6806f}.connection>view{flex:1}.connection button{width:auto;height:42rpx;margin:0;padding:0 13rpx;border:1rpx solid rgba(255,255,255,.23);border-radius:21rpx;background:transparent;color:#fff;font-size:16rpx;line-height:40rpx}
.unavailable-card{margin-top:24rpx;padding:54rpx 34rpx;display:flex;flex-direction:column;align-items:center;text-align:center}.unavailable-icon{width:86rpx;height:86rpx;border-radius:27rpx;background:#efe3dc;color:#a34e3b;font-size:27rpx;font-weight:800;line-height:86rpx}.unavailable-card>text:nth-child(2){margin-top:26rpx;font-size:29rpx;font-weight:800}.unavailable-card>text:nth-child(3){margin-top:13rpx;color:#8e847b;font-size:20rpx;line-height:1.65}.unavailable-card button{width:100%;height:72rpx;margin-top:32rpx;border-radius:36rpx;background:#4c6259;color:#fff;font-size:22rpx;line-height:72rpx}
.login-card{margin-top:24rpx;padding:28rpx}.login-field{min-height:82rpx;margin-top:20rpx;padding:0 18rpx;border:1rpx solid #ded3c8;border-radius:19rpx;background:#f8f3ec;display:flex;align-items:center;gap:15rpx}.login-field>text{width:86rpx;color:#756b62;font-size:19rpx}.login-field input{height:80rpx;min-width:0;flex:1;font-size:21rpx}.login-field button{width:70rpx;height:48rpx;margin:0;padding:0;border-radius:24rpx;background:#e7dfd5;color:#695f57;font-size:16rpx;line-height:48rpx}.security-tip{display:block;margin-top:18rpx;color:#8a8178;font-size:17rpx;text-align:center}.login-error{display:block;margin-top:16rpx;padding:15rpx;border-radius:15rpx;background:#f3dfd9;color:#9e4937;font-size:18rpx;text-align:center}
.mode-tabs{height:79rpx;margin-top:24rpx;padding:7rpx;border-radius:40rpx;background:#e4dcd1;display:flex;box-sizing:border-box}.mode-tabs button{height:65rpx;flex:1;margin:0;padding:0;border:0;border-radius:33rpx;background:transparent;color:#786f67;font-size:22rpx;line-height:65rpx}.mode-tabs .active{background:#fffdf8;color:#9e4e39;font-weight:800;box-shadow:0 5rpx 15rpx rgba(68,50,36,.09)}
.operation-card{margin-top:19rpx;padding:25rpx}.operation-title{display:flex;align-items:flex-start;justify-content:space-between}.operation-title>view{display:flex;flex-direction:column;gap:7rpx}.operation-title>view text:first-child{font-size:28rpx;font-weight:800}.operation-title>view text:last-child{color:#978c82;font-size:17rpx}.operation-title>text{color:#ded3c6;font-size:38rpx;font-weight:850}.scan-button{width:100%;height:142rpx;margin-top:24rpx;padding:0 25rpx;border:0;border-radius:24rpx;background:linear-gradient(120deg,#3b5c51,#597264);color:#fff;display:flex;align-items:center;text-align:left}.scan-frame{width:75rpx;height:75rpx;margin-right:20rpx;border:2rpx solid rgba(255,255,255,.55);border-radius:20rpx;text-align:center;font-size:45rpx;line-height:70rpx}.scan-button>view{display:flex;flex-direction:column;gap:8rpx}.scan-button>view text:first-child{font-size:26rpx;font-weight:800}.scan-button>view text:last-child{color:rgba(255,255,255,.66);font-size:17rpx}.scan-button[disabled],.primary-button[disabled]{opacity:.48}.divider{margin:22rpx 0;display:flex;align-items:center;gap:12rpx;color:#afa59b;font-size:16rpx}.divider text:first-child,.divider text:last-child{height:1rpx;flex:1;background:#ebe2d9}.code-input{height:76rpx;display:flex;gap:11rpx}.code-input input{height:76rpx;min-width:0;flex:1;padding:0 18rpx;border:1rpx solid #ded3c8;border-radius:19rpx;background:#f8f3ec;box-sizing:border-box;font-size:19rpx}.code-input button{width:150rpx;height:76rpx;margin:0;padding:0;border-radius:19rpx;background:#a5503b;color:#fff;font-size:20rpx;line-height:76rpx}.code-input button[disabled]{background:#c8bbb0;color:#eee8e1}
.identity-notice{margin-top:23rpx;padding:16rpx 18rpx;border-radius:19rpx;background:#edf2ee;color:#617469;display:flex;align-items:center;gap:13rpx;font-size:17rpx;line-height:1.5}.identity-notice>text:first-child{width:40rpx;height:40rpx;flex-shrink:0;border-radius:13rpx;background:#6d8478;color:#fff;text-align:center;font-weight:800;line-height:40rpx}.identity-input{min-height:90rpx;margin-top:19rpx;padding:0 19rpx;border:1rpx solid #ded4c9;border-radius:20rpx;background:#faf6ef;display:flex;align-items:center;gap:20rpx}.identity-input>text{color:#746a62;font-size:19rpx}.identity-input input{height:88rpx;min-width:0;flex:1;text-align:right;font-size:21rpx}.primary-button{width:100%;height:75rpx;margin-top:19rpx;border-radius:38rpx;background:#a5503b;color:#fff;font-size:22rpx;font-weight:750;line-height:75rpx}
.result-card{margin-top:20rpx;padding:23rpx;position:relative;display:grid;grid-template-columns:68rpx 1fr;gap:16rpx}.result-success{border-color:rgba(65,123,91,.18);background:#f8fdf9}.result-error{border-color:rgba(168,72,51,.18);background:#fff9f6}.result-mark{width:60rpx;height:60rpx;border-radius:20rpx;background:#4f7d65;color:#fff;text-align:center;font-size:33rpx;font-weight:850;line-height:60rpx}.result-error .result-mark{background:#ae513e}.result-head{display:flex;justify-content:space-between}.result-head>view{display:flex;flex-direction:column;gap:6rpx}.result-head>view text:first-child{font-size:26rpx;font-weight:850}.result-head>view text:last-child{max-width:500rpx;color:#917f76;font-size:17rpx;line-height:1.5}.result-head button{width:44rpx;height:44rpx;margin:0;padding:0;border:0;border-radius:50%;background:#ede5dd;color:#887c72;font-size:27rpx;line-height:40rpx}.result-grid,.release-tip,.stop-tip{grid-column:1/3}.result-grid{margin-top:3rpx;padding-top:17rpx;border-top:1rpx solid #e5ece6;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.result-grid view{display:flex;flex-direction:column;gap:5rpx}.result-grid view text:first-child{color:#9c9187;font-size:15rpx}.result-grid view text:last-child{font-size:19rpx;font-weight:700;word-break:break-all}.release-tip,.stop-tip{padding:13rpx 16rpx;border-radius:16rpx;text-align:center;font-size:18rpx;font-weight:700}.release-tip{background:#dfeee5;color:#47705b}.stop-tip{background:#f3dfd9;color:#9e4937}
.history-section{margin-top:30rpx}.section-head{margin:0 4rpx 15rpx;display:flex;align-items:flex-end;justify-content:space-between}.section-head>view{display:flex;flex-direction:column;gap:5rpx}.section-head>view text:first-child{font-size:25rpx;font-weight:800}.section-head>view text:last-child,.section-head>text{color:#9c9188;font-size:16rpx}.history-empty{padding:38rpx 25rpx;display:flex;flex-direction:column;align-items:center}.history-empty>text:first-child{width:62rpx;height:62rpx;border-radius:19rpx;background:#eee7de;color:#9a705e;text-align:center;font-size:21rpx;font-weight:800;line-height:62rpx}.history-empty>text:nth-child(2){margin-top:17rpx;font-size:22rpx;font-weight:750}.history-empty>text:nth-child(3){margin-top:7rpx;color:#9a9087;font-size:17rpx}.history-item{min-height:118rpx;margin-bottom:12rpx;padding:18rpx;display:flex;align-items:flex-start;gap:15rpx}.history-status{width:48rpx;height:48rpx;flex-shrink:0;border-radius:16rpx;color:#fff;text-align:center;font-size:24rpx;font-weight:800;line-height:48rpx}.history-success{background:#56816b}.history-failed{background:#ae5b47}.history-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:7rpx}.history-copy>view{display:flex;align-items:center;justify-content:space-between}.history-copy>view text:first-child{font-size:20rpx;font-weight:800}.history-copy>view text:last-child{color:#a1968d;font-size:14rpx}.history-copy>text:nth-child(2){color:#554c45;font-size:18rpx;line-height:1.4}.history-copy>text:nth-child(3){color:#9b9087;font-size:15rpx;word-break:break-all}.safe-space{height:45rpx}
